{
    "name": "wpelevator/run-parallel-example",
    "repositories": [
        {
            "type": "path",
            "url": "../",
            "options": {
                "symlink": true
            }
        }
    ],
    "require-dev": {
        "wpelevator/run-parallel": "@dev",
        "wp-coding-standards/wpcs": "^3.3"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "run-parallel --path-pattern='packages/*/phpcs.xml,packages/*/phpcs.xml.dist' --command='phpcs --standard={path} {path | dirname}' --processes=2",
        "format": "run-parallel --path-pattern='packages/*/phpcs.xml,packages/*/phpcs.xml.dist' --command='phpcbf --standard={path} {path | dirname}' --processes=2"
    }
}
