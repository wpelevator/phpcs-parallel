{
    "name": "wpelevator/phpcs-parallel",
    "description": "Run PHPCS and PHPCBF across monorepos with isolated per-project configs, optionally in parallel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "squizlabs/php_codesniffer": "^3.7 || ^4.0",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/process": "^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "WPElevator\\PHPCSParallel\\": "src/"
        }
    },
    "bin": [
        "bin/phpcs-parallel",
        "bin/phpcbf-parallel"
    ],
    "scripts": {
        "lint": "phpcs",
        "format": "phpcbf",
        "analyse": "phpstan analyse",
        "test": "phpunit"
    }
}
