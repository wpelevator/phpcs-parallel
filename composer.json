{
    "name": "wpelevator/run-parallel",
    "description": "Run one command per matched path, optionally in parallel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/process": "^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.2",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "replace": {
        "wpelevator/phpcs-parallel": "self.version"
    },
    "autoload": {
        "psr-4": {
            "WPElevator\\RunParallel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WPElevator\\RunParallel\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/run-parallel"
    ],
    "scripts": {
        "lint": "phpcs",
        "format": "phpcbf",
        "analyse": "phpstan analyse",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text --coverage-clover=tests/coverage/clover.xml --coverage-html=tests/coverage/html"
    }
}
